# ── Production .env для Plesk (Laravel Toolkit → «Змінні середовища») ──
# Замініть цим шаблоном той .env, що створює Toolkit (там local + debug + SQLite).

APP_NAME="Розклад"
APP_ENV=production
# Згенерувати один раз: в «Виконавці» Toolkit → key:generate (або php artisan key:generate --show локально)
APP_KEY=
APP_DEBUG=false
APP_URL=https://ВАШ-ДОМЕН
APP_TIMEZONE=Europe/Kyiv

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── База даних (Plesk → «Бази даних»: окрема БД і користувач) ──
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ВАША_БАЗА
DB_USERNAME=ВАШ_КОРИСТУВАЧ
DB_PASSWORD=ВАШ_ПАРОЛЬ

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie сесії лише по HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ВАШ-ДОМЕН"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
